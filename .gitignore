# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env overrides — .env.example stays tracked as the template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated by scripts/buildClimatologyCombinedTiles.ts — large binary data, regenerate via the
# script rather than tracking in git.
/.climatology-combined-cache
/public/climatology
/public/climatology-hourly

# Generated by scripts/copyMaplibreWorker.mjs (runs on postinstall and before every build) —
# copied straight from the installed maplibre-gl version, never hand-maintained.
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs
