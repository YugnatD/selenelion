# Copy to .env.local for local overrides, or set as a build-time env var on your host.

# Base URL for the climatology tile set (public/climatology, public/climatology-hourly), no
# trailing slash. Leave unset to fetch tiles from the app's own origin (the default — matches
# running `npm run build:climatology` and serving public/ alongside the rest of the build).
# Set this when the ~800MB tile set is hosted separately, e.g. a Cloudflare R2 bucket with its own
# CDN — the bucket needs a CORS policy allowing GET from wherever the app is served.
# VITE_CLIMATOLOGY_BASE_URL=https://climatology.example.com
